# Environment Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
PROJECT_NAME="PAIMANA PredictIQ"

# Database Configuration (PostgreSQL)
POSTGRES_USER=paimana_user
POSTGRES_PASSWORD=paimana_password
POSTGRES_DB=paimana_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://paimana_user:paimana_password@postgres:5432/paimana_db

# Local Database URL (for running backend outside Docker)
LOCAL_DATABASE_URL=postgresql://paimana_user:paimana_password@localhost:5432/paimana_db

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_TITLE="PAIMANA PredictIQ"

# ML Configuration
MODEL_DIR=./models
DATA_DIR=./data

# Intelligence providers (optional; absent providers report unavailable)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPERATOR_API_KEY=
# At least 32 random characters; keep stable across restarts
ACTION_SIGNING_KEY=
PUBLIC_API_URL=https://your-host.example/api/v1
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional routing per escalation tier
TELEGRAM_CHAT_ID_TIER_1=
TELEGRAM_CHAT_ID_TIER_2=
TELEGRAM_CHAT_ID_TIER_3=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TO=
WHATSAPP_GRAPH_VERSION=v23.0
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# Choose a Live audio model enabled for your Gemini account.
GEMINI_LIVE_MODEL=
# Organization-managed normalized WPI + rainfall observation JSON feed; see docs.
MARKET_FEED_URL=
MARKET_FEED_TOKEN=

# Planetary Computer account key for Sentinel-1 RTC imagery.
PC_SDK_SUBSCRIPTION_KEY=
